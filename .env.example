# Local dev defaults matching docker-compose.yml. Copy to .env to override.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=peoplegraph-dev
REDIS_URL=redis://localhost:6379
PORT=3000
LOG_LEVEL=info
NEO4J_READ_TIMEOUT_MS=5000
NEO4J_WRITE_TIMEOUT_MS=10000
# People-you-may-know weights and traversal bounds (docs/adr/0002)
PYMK_W_MUTUAL=3
PYMK_W_INTEREST=2
PYMK_W_FOLLOWS_YOU=5
PYMK_MAX_FRIENDS=200
PYMK_MAX_FANOUT=1000
PYMK_MAX_INTEREST_FANOUT=5000
PYMK_MAX_FOLLOWERS_SCAN=5000
PYMK_CANDIDATES_PER_SOURCE=100
